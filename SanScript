-- สถานะการทำงาน
local isEnabled = false

local function leaveGame()
    LocalPlayer:Kick("HeroScript: ตรวจพบสถานะ Wanted ทำการเตะออกแมพอัตโนมัติ!")
end

local function checkWanted()
    if not isEnabled then return end
    if WantedLevelUtil then
        local level = WantedLevelUtil.GetWantedLevelAttribute(LocalPlayer)
        if level and level > 0 then
            leaveGame()
        end
    end
end

-- กดเปิด-ปิด Toggle Switch พร้อมแอนิเมชันลื่นๆ
ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    if isEnabled then
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 200, 110)}):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        ToggleCircle:TweenPosition(UDim2.new(1, -19, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
    else
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 160, 175)}):Play()
        ToggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
    end
end)

-- ลูปเช็คสถานะดาวตลอดเวลา
task.spawn(function()
    while task.wait(0.5) do
        if isEnabled then
            pcall(checkWanted)
        end
    end
end)
