-- ==================== Logic ====================
local isEnabled = false

local function leaveGame()
	LocalPlayer:Kick("HeroScript: ตรวจพบสถานะ Wanted ทำการเตะออกแมพอัตโนมัติ!")
end

local function checkWanted()
	if not isEnabled then return end
	if WantedLevelUtil then
		local level = WantedLevelUtil.GetWantedLevelAttribute(LocalPlayer)
		if level and level > 0 then
			leaveGame()
		end
	end
end

-- Toggle + Notification
ToggleBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled

	if isEnabled then
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(140, 70, 230)
		}):Play()
		TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		}):Play()
		ToggleCircle:TweenPosition(UDim2.new(1, -19, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)

		ShowNotification("Anti-Wanted เปิดใช้งานแล้ว", true)
	else
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(45, 30, 70)
		}):Play()
		TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(160, 140, 190)
		}):Play()
		ToggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)

		ShowNotification("Anti-Wanted ปิดใช้งานแล้ว", false)
	end
end)

-- ลูปเช็คสถานะดาว
task.spawn(function()
	while task.wait(0.5) do
		if isEnabled then
			pcall(checkWanted)
		end
	end
end)
