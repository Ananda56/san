	icon.TextSize = 18

	local label = Instance.new("TextLabel")
	label.Parent = notif
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 46, 0, 0)
	label.Size = UDim2.new(1, -56, 1, 0)
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 225, 255)
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left

	TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
		Position = UDim2.new(1, -300, 0, 20)
	}):Play()

	task.delay(2.2, function()
		local t = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position = UDim2.new(1, 20, 0, 20)
		})
