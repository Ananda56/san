-- สถานะการทำงานของฟังก์ชัน Anti-Wanted
local isEnabled = false

-- ฟังก์ชันออกจากเกม
local function leaveGame()
    LocalPlayer:Kick("Vortex: ตรวจพบสถานะ Wanted ทำการเตะออกแมพอัตโนมัติ!")
end

-- เช็คสถานะดาว
local function checkWanted()
    if not isEnabled then return end
    if WantedLevelUtil then
        local level = WantedLevelUtil.GetWantedLevelAttribute(LocalPlayer)
        if level and level > 0 then
            leaveGame()
        end
    end
end

-- กดเปิด-ปิด Toggle Switch
ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    if isEnabled then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 70, 220) -- สีม่วงสไตล์ Vortex เมื่อเปิด
        ToggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ToggleCircle:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        print("Vortex: Anti-Wanted Enabled")
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        ToggleCircle.BackgroundColor3 = Color3.fromRGB(150, 150, 160)
        ToggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        print("Vortex: Anti-Wanted Disabled")
    end
end)

-- ลูปเช็คสถานะตลอดเวลาเมื่อเปิดใช้งาน
task.spawn(function()
    while task.wait(0.5) do
        if isEnabled then
            pcall(checkWanted)
        end
    end
end)
