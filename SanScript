-- ==================== Anti-Wanted Logic ====================
local isEnabled = false

local function checkWanted()
	if not isEnabled then return end
	if WantedLevelUtil then
		local level = WantedLevelUtil.GetWantedLevelAttribute(LocalPlayer)
		if level and level > 0 then
			LocalPlayer:Kick("HeroScript: ตรวจพบ Wanted! เตะออกอัตโนมัติ")
		end
	end
end

ToggleBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled
	if isEnabled then
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(140, 70, 230)}):Play()
		TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
		ToggleCircle:TweenPosition(UDim2.new(1, -19, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
		ShowNotification("Anti-Wanted เปิดแล้ว", true)
	else
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 30, 70)}):Play()
		TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 140, 190)}):Play()
		ToggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
		ShowNotification("Anti-Wanted ปิดแล้ว", false)
	end
end)

task.spawn(function()
	while task.wait(0.5) do
		if isEnabled then pcall(checkWanted) end
	end
end)

-- ==================== Auto Key Logic ====================
local autoKeyEnabled = false
local currentKey = Enum.KeyCode.Space
local units = {"ms", "วินาที", "นาที", "ชั่วโมง"}
local unitIndex = 2
local currentUnit = "วินาที"

local function getWaitTime()
	local num = tonumber(TimeBox.Text) or 1
	if currentUnit == "ms" then return math.max(num / 1000, 0.01)
	elseif currentUnit == "วินาที" then return math.max(num, 0.01)
	elseif currentUnit == "นาที" then return math.max(num * 60, 0.01)
	elseif currentUnit == "ชั่วโมง" then return math.max(num * 3600, 0.01)
	end
	return 1
end

local function pressKey()
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, currentKey, false, game)
		task.wait(0.03)
		VirtualInputManager:SendKeyEvent(false, currentKey, false, game)
	end)
end

-- เปลี่ยนหน่วย
UnitBtn.MouseButton1Click:Connect(function()
	unitIndex = unitIndex % #units + 1
	currentUnit = units[unitIndex]
	UnitBtn.Text = currentUnit
end)

-- ตั้งค่า Key
local waitingForKey = false
SetKeyBtn.MouseButton1Click:Connect(function()
	if waitingForKey then return end
	waitingForKey = true
	SetKeyBtn.Text = "กดปุ่มเลย..."
	SetKeyBtn.TextColor3 = Color3.fromRGB(255, 200, 80)

	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			currentKey = input.KeyCode
			SetKeyBtn.Text = "Key: " .. tostring(input.KeyCode.Name)
			SetKeyBtn.TextColor3 = Color3.fromRGB(200, 180, 240)
			waitingForKey = false
			conn:Disconnect()
		end
	end)
end)

