-- ==================== Notification System ====================
local function ShowNotification(text, isOn)
	local notif = Instance.new("Frame")
	notif.Name = "Notification"
	notif.Parent = ScreenGui
	notif.BackgroundColor3 = Color3.fromRGB(28, 18, 42)
	notif.BorderSizePixel = 0
	notif.Size = UDim2.new(0, 280, 0, 52)
	notif.Position = UDim2.new(1, 20, 0, 20) -- เริ่มนอกจอ
	notif.ZIndex = 100

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = notif

	local stroke = Instance.new("UIStroke")
	stroke.Color = isOn and Color3.fromRGB(160, 90, 255) or Color3.fromRGB(90, 70, 120)
	stroke.Thickness = 1.5
	stroke.Parent = notif

	local accent = Instance.new("Frame")
	accent.Parent = notif
	accent.BackgroundColor3 = isOn and Color3.fromRGB(160, 90, 255) or Color3.fromRGB(120, 80, 160)
	accent.BorderSizePixel = 0
	accent.Size = UDim2.new(0, 4, 1, 0)
	accent.Position = UDim2.new(0, 0, 0, 0)

	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(0, 10)
	accentCorner.Parent = accent

	local icon = Instance.new("TextLabel")
	icon.Parent = notif
	icon.BackgroundTransparency = 1
	icon.Position = UDim2.new(0, 16, 0, 0)
	icon.Size = UDim2.new(0, 28, 1, 0)
	icon.Font = Enum.Font.GothamBold
	icon.Text = isOn and "⚡" or "✕"
	icon.TextColor3 = isOn and Color3.fromRGB(190, 130, 255) or Color3.fromRGB(180, 150, 210)
	icon.TextSize = 18
	icon.TextXAlignment = Enum.TextXAlignment.Left

	local label = Instance.new("TextLabel")
	label.Parent = notif
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 48, 0, 0)
	label.Size = UDim2.new(1, -60, 1, 0)
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 225, 255)
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center

	-- เลื่อนเข้ามา
	TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -300, 0, 20)
	}):Play()

	-- หายไปหลัง 2.2 วินาที
	task.delay(2.2, function()
		local out = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position = UDim2.new(1, 20, 0, 20)
		})
		out:Play()
		out.Completed:Connect(function()
			notif:Destroy()
		end)
	end)
end

